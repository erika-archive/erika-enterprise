bitfld.long 0x00 18.        "  GT ,Positive (GT)" "0,1"
bitfld.long 0x00 17.        "  EQ ,Zero (EQ)" "0,1"
bitfld.long 0x00 16.        "  SO ,Summary overflow (SO)" "0,1"
TEXTLINE "                "
bitfld.long 0x00 15.        "  CR4:  LT ,Negative (LT)" "0,1"
bitfld.long 0x00 14.        "  GT ,Positive (GT)" "0,1"
bitfld.long 0x00 13.        "  EQ ,Zero (EQ)" "0,1"
bitfld.long 0x00 12.        "  SO ,Summary overflow (SO)" "0,1"
TEXTLINE "                "
bitfld.long 0x00 11.        "  CR5:  LT ,Negative (LT)" "0,1"
bitfld.long 0x00 10.        "  GT ,Positive (GT)" "0,1"
bitfld.long 0x00 09.        "  EQ ,Zero (EQ)" "0,1"
bitfld.long 0x00 08.        "  SO ,Summary overflow (SO)" "0,1"
TEXTLINE "                "
bitfld.long 0x00 07.        "  CR6:  LT ,Negative (LT)" "0,1"
bitfld.long 0x00 06.        "  GT ,Positive (GT)" "0,1"
bitfld.long 0x00 05.        "  EQ ,Zero (EQ)" "0,1"
bitfld.long 0x00 04.        "  SO ,Summary overflow (SO)" "0,1"
TEXTLINE "                "
bitfld.long 0x00 03.        "  CR7:  LT ,Negative (LT)" "0,1"
bitfld.long 0x00 02.        "  GT ,Positive (GT)" "0,1"
bitfld.long 0x00 01.        "  EQ ,Zero (EQ)" "0,1"
bitfld.long 0x00 00.        "  SO ,Summary overflow (SO)" "0,1"

TEXTLINE ""

group.long SPR:1.++0
line.long   0x00 "XER,Integer Exception Register"
bitfld.long 0x00 31.        "SO ,Summary Overflow (per Book E)" "0,1"
bitfld.long 0x00 30.        "  OV ,Overflow (per Book E)" "0,1"
bitfld.long 0x00 29.        "  CA ,Carry (per Book E)" "0,1"
hexmask.long.byte 0 00.--06. 1 "  BYTECOUNT ,This field specifies the number of bytes to be transferred by a lswx or stswx instruction"

tree.end

tree "Processor Control Registers"

rgroup.long SPR:286.++0
line.long   0x00 "PIR,Processor ID Register"
hexmask.byte 3. 00.--07. 1. "PID ,These bit are a reflection of the values provided on the p_cpuid[0:7] input signals"


group.long SPR:1008.++0
line.long   0x00 "HID0,Hardware Implementation Dependent Register 0"
bitfld.long 0x00 31.        "EMCP    ,Enable machine check pin" "0,1"
bitfld.long 0x00 24.--25. "  BPRED   ,Branch prediction (acceleration) control" "enabled,disabled for backward branches,disabled for forward branches,disabled for both branch directions "
TEXTLINE "                "
bitfld.long 0x00 23.      "  DOZE    ,Configure for doze power management mode" "0,1" 
bitfld.long 0x00 22.      "  NAP     ,Configure for nap power management mode" "0,1"
bitfld.long 0x00 21.      "  SLEEP   ,Configure for sleep power management mode" "0,1"

bitfld.long 0x00 17.      "  ICR     ,Interrupt inputs clear reservation" "0,1"
bitfld.long 0x00 16.      "  NHR     ,Not hardware reset" "0,1"

TEXTLINE "                "

bitfld.long 0x00 14.      "  TBEN    ,Timebase enable" "0,1"
bitfld.long 0x00 13.      "  SL_TBCK ,Select timebase clock" "0,1"
bitfld.long 0x00 12.      "  DCLREE  ,Debug interrupt clears MSR[EE]" "0,1"
bitfld.long 0x00 11.      "  DCLRCE  ,Debug Interrupt Clears MSR[CE]" "0,1"
bitfld.long 0x00 10.      "  CICLRDE ,Critical Interrupt Clears MSR[DE]" "0,1"
bitfld.long 0x00 09.      "  MCCLRDE ,Machine check interrupt clears MSR[DE]" "0,1"
bitfld.long 0x00 08.      "  DAPUEN  ,Debug APU enable" "0,1"

TEXTLINE ""

group.long SPR:1009.++0
line.long   0x00 "HID1,Hardware Implementation Dependent Register 1"
bitfld.long 0x00 07.        "ATS     ,Atomic status (read-only)" "0,1"

TEXTLINE ""

group.long SPR:1023.++0
line.long   0x00 "SVR,System Version Register"

tree.end

tree "Exception Handling/Control Registers"
group.long SPR:62.++0
line.long   0x00 "ESR,Exception Syndrome Register"
bitfld.long 0x00 27.        "PIL   ,Illegal instruction exception" "0,1"
bitfld.long 0x00 26.      "  PPR   ,Privileged instruction exception" "0,1"
bitfld.long 0x00 25.      "  PTR   ,Trap exception" "0,1"
bitfld.long 0x00 24.      "  FP    ,Floating-point operation" "0,1"
bitfld.long 0x00 23.      "  ST    ,Store operation" "0,1"
TEXTLINE "                "

bitfld.long 0x00 21.      "  DLK   ,Data cache locking" "0,1"
bitfld.long 0x00 20.      "  ILK   ,Instruction cache locking" "0,1"
bitfld.long 0x00 19.      "  AP    ,Auxiliary processor operation" "0,1"
bitfld.long 0x00 18.      "  PUO   ,Unimplemented operation exception" "0,1"
bitfld.long 0x00 17.      "  BO    ,Byte Ordering exception" "0,1"
bitfld.long 0x00 16.      "  PIE   ,Program Imprecise exception" "0,1"
TEXTLINE "                "

bitfld.long 0x00 07.      "  SPE   ,SPE APU Operation" "0,1"

bitfld.long 0x00 00.      "  XTE   ,External termination error (Precise)" "0,1"


TEXTLINE ""

