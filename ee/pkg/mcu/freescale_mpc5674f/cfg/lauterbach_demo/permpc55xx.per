sif CPUIS("MPC5674*")
tree "Frequency Modulated Phase Locked Loop (FMPLL)"

group.long 0xC3F80004++0x03
  line.long    0x00 "SYNSR,Synthesizer Status Register"
  eventfld.long  0x00 09.              "LOLF     ,Loss of lock flag" "0,1"
  bitfld.long  0x00 08.              "  LOC      ,Loss Of clock status" "0,1"
  bitfld.long  0x00 07.              "  MODE ,Clock mode." "off,clock"
  bitfld.long  0x00 06.              " PLLSEL ,PLL mode select" "off,normal"
TEXTLINE "                "
  bitfld.long  0x00 05.              "  PLLREF ,PLL clock reference source" "Ext,Xtal"
  bitfld.long  0x00 04.               " LOCKS    ,Sticky PLL lock status bit" "0,1"
  bitfld.long  0x00 03.              "  LOCK ,PLL lock status bit" "0,1"
  eventfld.long  0x00 02.            "     LOCF   ,Loss of clock flag" "0,1"
TEXTLINE "                "
  eventfld.long  0x00 02.            "  CALDONE  ,Calibration Complete" "0,1"
  eventfld.long  0x00 02.            "  CALPASS  ,Calibration Passed" "0,1"
TEXTLINE ""

group.long 0xC3F80008++0x03
  line.long    0x00 "ESYNCR1,PLL Enhanced Synthesizer Control Register 1"
  bitfld.long  0x00 28.--30.             "CLKCFG  ,Clock Configuration" "0,1,2,3,4,5,6,7"
  bitfld.long  0x00 16.--19.             "  EPREDIV    ,Enhanced Pre-Divider" "1:1,1:2,1:3,1:4,1:5,1:6,res.,1:8,res.,1:10,res.,res.,res.,res.,res.,res."
  hexmask.long.byte 0x00 00.--07. 1. 0.  "  EMFD    ,Enhanced Multiplication Factor Divider"

group.long 0xC3F8000C++0x03
  line.long    0x00 "ESYNCR2,PLL Enhanced Synthesizer Control Register 2"
  bitfld.long  0x00 23.                "LOCEN   ,Loss of clock enable" "0,1"
  bitfld.long  0x00 22.              "  LOLRE      ,Loss of lock reset enable" "0,1"
  bitfld.long  0x00 21.              "     LOCRE   ,Loss of clock reset enable" "0,1"
TEXTLINE "                "
  bitfld.long  0x00 20.              "  LOLIRQ  ,Loss of lock interrupt request" "0,1"
  bitfld.long  0x00 19.              "  LOCIRQ     ,Loss of clock interrupt request" "0,1"
TEXTLINE "                "
  bitfld.long  0x00 16.--17.         "  ERATE   ,Enhanced modulation rate" "1/80,1/40,1/20,res."
  bitfld.long  0x00 15.              "                CLKCFG_DIS ,The CLKCFG_DIS bit is used to disable the ability to change the PLL mode using the CLKCFG bits" "0,1"
TEXTLINE "                "
  bitfld.long  0x00 08.--10.         "  EDEPTH  ,Enhanced modulation rate" "0%,0.25%~0.5%,0.75%~1%,1.25%~1.5%,1.75%~2%,res.,res.,res." 
  hexmask.long.byte 0x00 00.--05. 1. 0.  "          ERFD    ,Enhanced Reduced Frequency Divider"

tree.end

else
