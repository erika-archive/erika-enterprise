tree "Branch Target Buffer Registers"

group.long SPR:1013.++0
  line.long 0. "BUCSR,Branch Unit Control and Status Register"
  bitfld.long  0. 09.            "BBFI   ,Branch buffer flash invalidate"       "0,1"

sif CPUIS("MPC5674*")
  textline "                "
  bitfld.long  0. 04.--05.     "  BALLOC ,Branch Target Buffer Allocation Control"  "both enabled,forward only,backward only,both disabled"
  textline "                "
  bitfld.long  0. 01.--02.     "  BPRED  ,Branch Prediction Control (static)"       "both enabled,forward only,backward only,both disabled"
  textline "                "
endif

  bitfld.long  0. 00.          "  BPEN   ,Branch prediction enable"             "0,1"
tree.end

tree "Timer Registers"
  group spr:340.++0
    line.long 0x0 "TCR,Timer Control Register"
      bitfld.long   0x0 30.--31.       "WP  ,Watchdog timer period" "0,1,2,3"
      bitfld.long   0x0 28.--29.     "  WRC ,Watchdog timer reset control" "disabled,checkstop,!RSTOUT,res."
      bitfld.long   0x0 27.          "  WIE ,Watchdog timer interrupt enable" "0,1"
      bitfld.long   0x0 26.          "  DIE ,Decrementer interrupt enable" "0,1"
      bitfld.long   0x0 24.--25.     "  FP  ,Fixed-interval timer period" "0,1,2,3"
      bitfld.long   0x0 23.          "  FIE ,Fixed-interval timer interrupt enable" "0,1"
      bitfld.long   0x0 22.          "  ARE ,Auto-reload enable" "0,1"
      bitfld.long   0x0 17.--20.     "  WPEXT ,Watchdog timer period extention" "WP,WP+4,WP+8,WP+12,WP+16,WP+20,WP+24,WP+28,WP+32,WP+36,WP+40,WP+44,WP+48,WP+52,WP+56,WP+60"
      bitfld.long   0x0 13.--16.     "  FPEXT ,Fixed-interval timer extention" "FP,FP+4,FP+8,FP+12,FP+16,FP+20,FP+24,FP+28,FP+32,FP+36,FP+40,FP+44,FP+48,FP+52,FP+56,FP+60"

  group spr:336.++0
    line.long 0x0 "TSR,Timer Status Register"
      eventfld.long   0x0 31.          "ENW ,Enable next watchdog" "0,1"
      eventfld.long   0x0 30.          "  WIS ,Watchdog timer interrupt status" "0,1"
      eventfld.long   0x0 28.--29.     "  WRS ,Watchdog timer reset status" "none,checkstop,!RSTOUT,res."
      eventfld.long   0x0 27.          "  DIS ,Decrementer timer interrupt status" "0,1"
      eventfld.long   0x0 26.          "  FIS ,Fixed-interval timer interrupt status" "0,1"

  TEXTLINE ""

  group spr:285.++0
    line.long 0x0 "TBU,Upper Time Base Register"

  group spr:284.++0
    line.long 0x0 "TBL,Lower Time Base Register"

  TEXTLINE ""

  group spr:22.++0
    line.long 0x0 "DEC,Decrementer Register"

  group spr:54.++0
    line.long 0x0 "DECAR,Decrementer Auto-Reload Register"

tree.end

