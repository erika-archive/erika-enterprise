bitfld.long 0x00 29.        "  EQ ,Zero (EQ)" "0,1"
bitfld.long 0x00 28.        "  SO ,Summary overflow (SO)" "0,1"
TEXTLINE "                "
bitfld.long 0x00 27.        "  CR1:  LT ,Negative (LT)" "0,1"
bitfld.long 0x00 26.        "  GT ,Positive (GT)" "0,1"
bitfld.long 0x00 25.        "  EQ ,Zero (EQ)" "0,1"
bitfld.long 0x00 24.        "  SO ,Summary overflow (SO)" "0,1"
TEXTLINE "                "
